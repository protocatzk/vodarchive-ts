{
  "name": "vodarchive-ts",
  "version": "1.0.0",
  "description": "Telegram-Archiv fuer Streamrecorder-VODs (per n8n) und fuer rss.app-Feeds. TypeScript + Vue Rewrite.",
  "type": "commonjs",
  "main": "dist/backend/main.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/backend/main.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:api",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/backend/main.js",
    "typecheck": "vue-tsc -p tsconfig.frontend.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "vod",
    "telegram",
    "archiver",
    "n8n",
    "rss"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "axios": "^1.7.9",
    "big-integer": "^1.6.52",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.12.1",
    "helmet": "^8.0.0",
    "pinia": "^2.3.0",
    "telegram": "^2.26.22",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@12.21.0"
}
