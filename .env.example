# ---- Server ----
PORT=8080
NODE_ENV=development
DATA_DIR=data

# ---- Dashboard-Auth ----
# ACHTUNG: nur fuer lokale Entwicklung. Ueberspringt den Telegram-Login.
AUTH_DEV_MODE=true
AUTH_DEV_USER=@dev
# Kommagetrennte Telegram-Handles/IDs, die sich anmelden duerfen.
ALLOWED_DASHBOARD_USERS=@Ripperchieff,@x42067
AUTH_SESSION_TTL_SECONDS=2592000

# ---- Telegram (MTProto) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FORUM_CHAT_ID=
FORWARD_DROP_AUTHOR=true
# Persistente GramJS-StringSession (wird automatisch erzeugt)
TELEGRAM_SESSION_FILE=data/telegram.session

# ---- Jobs / Media ----
JOB_DONE_TTL_DAYS=14
JOB_STALE_DAYS=3
JOB_FAILED_TTL_DAYS=30
# true = Upload-Pipeline simulieren (kein echter Download/Upload)
SIMULATE_JOBS=false
PARALLEL_UPLOAD_WORKERS=3
FFMPEG_THREADS=2
# Temporäre Job-Dateien nach erfolgreichem Upload behalten?
KEEP_JOB_FILES=false
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Topic-Cache ----
TOPICS_CACHE_FILE=data/topics_cache.json

# ---- RSS-Archiv (rss.app) ----
RSS_ENABLED=true
RSS_OPML_FILE=rss-app-opml.xml
RSS_FEED_URLS=
RSS_FEED_TITLES=
RSS_STATE_FILE=data/rss_state.json
RSS_POLL_INTERVAL_SECONDS=900
RSS_INITIAL_BACKFILL=false
RSS_MAX_ITEM_AGE_HOURS=48
RSS_MAX_ITEMS_PER_POLL=10
RSS_STATE_RETENTION_DAYS=90
RSS_ALLOW_LIVE=false
RSS_TOPIC_PER_FEED=true
RSS_ARCHIVE_CHAT_ID=
RSS_ARCHIVE_FORUM_CHAT_ID=
RSS_MAX_RETRIES=0
RSS_RETRY_BASE_SECONDS=900
RSS_RETRY_MAX_DELAY_SECONDS=21600
RSS_LIVE_RECHECK_SECONDS=900
RSS_BOT_PAUSE_SECONDS=3600
RSS_LIVE_MAX_AGE_DAYS=7
RSS_RETRY_MAX_AGE_DAYS=30
RSS_MAX_RETRIES_PER_POLL=3

# ---- yt-dlp ----
YTDLP_COOKIES_FILE=
YTDLP_POT_PROVIDER_URL=http://bgutil-provider:4416
YTDLP_PROXY=
YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_RETRIES=10
YTDLP_HTTP_CHUNK_SIZE=
YTDLP_FORMAT=

# ---- n8n ----
# JSON-Map: {"workflowName":"https://n8n.example/webhook/..."}
N8N_WEBHOOKS_JSON={}
N8N_WEBHOOK_TIMEOUT=20
N8N_TRIGGER_COOLDOWN=60


# ---- Streamrecorder (native Quelle, ersetzt die n8n-Workflows) ----
STREAMRECORDER_API_BASE=https://streamrecorder.io
STREAMRECORDER_COOKIE=
STREAMRECORDER_POLL_INTERVAL_SECONDS=900
