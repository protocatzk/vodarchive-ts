      "id": "202306ef-90f2-4899-8b30-e317009e4092",
      "name": "Get Streamrecorder Targets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        144
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
