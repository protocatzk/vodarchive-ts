    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst items = response.data || [];\nconst currentTarget = $('Loop Streamers').first().json;\nconst finishedVideos = [];\n\nfor (const item of items) {\n  if (item.status === 'finished' && item.downloaded === 'false' && item.sources && item.sources.length > 0) {\n    const bestSource = item.sources[0];\n    finishedVideos.push({\n      json: {\n        recording_id: item.id,\n        recorded_file_id: bestSource.recordedfileid,\n        streamer: item.target_name,\n        target_id: item.targetid,\n        title: item.streamtitle || 'No Title',\n        recorded_at: item.recorded_at,\n        duration: item.duration_hr,\n        filesize_mb: Math.round((bestSource.filesize || 0) / 1024 / 1024),\n        resolution: bestSource.resolution,\n        download_url: bestSource.downloadlink,\n        thumbnail_url: item.thumb_large || item.poster_small_270 || '',\n        platform: item.target_platform || 'tiktok',\n        category: item.streamcategory || '',\n        max_viewers: item.max_viewercount || 0,\n        avg_viewers: item.avg_viewercount || 0,\n        deletion_time: bestSource.deletiontime_hr || '',\n        player_url: item.token ? ('https://streamrecorder.io/userrecordings/recording/' + item.token) : '',\n        cookie: currentTarget.cookie\n      }\n    });\n  }\n}\n\nreturn finishedVideos;"
      },
