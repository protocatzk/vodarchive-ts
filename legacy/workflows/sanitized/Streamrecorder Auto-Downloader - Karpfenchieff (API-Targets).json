    {
      "parameters": {
        "jsCode": "const cfg = $('Configuration').first().json;\nconst res = $input.first().json;\nconst html = typeof res.data === 'string' ? res.data : (typeof res.body === 'string' ? res.body : '');\n\nif (!html) throw new Error('Streamrecorder: leere Antwort von /userrecordings');\n\nif (!html.includes('recordings-streamer-card')) {\n  if (/\\/_af\\/login|\\/login\\b/.test(html)) {\n    throw new Error('Streamrecorder: Login-Seite statt Aufnahmen - Session-Cookie abgelaufen?');\n  }\n  throw new Error('Streamrecorder: Target-Liste nicht gefunden (Cookie ungueltig oder Seitenlayout geaendert?)');\n}\n\nconst items = [];\nconst seen = new Set();\n\nfor (const chunk of html.split('<div class=\"recordings-streamer-card\"').slice(1)) {\n  const end = chunk.indexOf('>');\n  const tag = end >= 0 ? chunk.slice(0, end) : chunk.slice(0, 1200);\n  const idMatch = /id=\"target-(\\d+)\"/.exec(tag);\n  if (!idMatch || seen.has(idMatch[1])) continue;\n  seen.add(idMatch[1]);\n  const nameMatch = /data-sr-target=\"([^\"]*)\"/.exec(tag);\n  const platformMatch = /data-sr-target-platform=\"([^\"]*)\"/.exec(tag);\n  items.push({\n    json: {\n      target_id: idMatch[1],\n      target_name: nameMatch ? nameMatch[1] : '',\n      platform: platformMatch ? platformMatch[1] : '',\n      cookie: cfg.cookie,\n      limit: cfg.limit || 10,\n    },\n  });\n}\n\nif (items.length === 0) throw new Error('Streamrecorder: keine TargetIDs auf /userrecordings gefunden');\n\nreturn items;"
      },
